{
  "manifest_version": 3,
  "name": "Mako Browser",
  "version": "0.3.0",
  "description": "Connect this browser profile to Mako. Tasks control their own tabs without moving your pointer.",
  "key": "",
  "permissions": [
    "debugger",
    "nativeMessaging",
    "storage",
    "alarms",
    "tabGroups",
    "downloads"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Mako Browser"
  },
  "minimum_chrome_version": "125"
}
