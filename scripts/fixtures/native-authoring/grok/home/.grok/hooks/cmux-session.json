{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "touch \"$MAKO_FIXTURE_MARKER/grok-session-start\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "touch \"$MAKO_FIXTURE_MARKER/grok-stop\""
          }
        ]
      }
    ]
  }
}
