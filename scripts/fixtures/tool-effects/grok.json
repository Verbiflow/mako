{
  "harness": "grok",
  "source": "Shapes of ACP updates Grok 1.0.46 kept in ~/.grok/sessions/*/updates.jsonl on 2026-10-12 (run_terminal_command with `current_dir` and `exit_code`, search_replace with a `diff` of the text it replaced, write with a `diff` of the whole file), contents and paths neutralized.",
  "cases": [
    {
      "about": "A command in the background: its folder and exit code are in `rawOutput`; the file it writes through `tee` is named.",
      "records": [
        {
          "sessionUpdate": "tool_call",
          "toolCallId": "call_1",
          "title": "run_terminal_command",
          "rawInput": {
            "command": "npm test | tee test.log",
            "description": "Run the tests",
            "is_background": true
          },
          "_meta": {
            "x.ai/tool": {
              "version": 1,
              "name": "run_terminal_command",
              "kind": "execute",
              "namespace": "grok_build",
              "label": "Run Command",
              "read_only": false
            }
          }
        },
        {
          "sessionUpdate": "tool_call_update",
          "toolCallId": "call_1",
          "kind": "execute",
          "title": "Execute `npm test | tee test.log`",
          "rawInput": {
            "variant": "Bash",
            "command": "npm test | tee test.log",
            "description": "Run the tests",
            "is_background": true
          }
        },
        {
          "sessionUpdate": "tool_call_update",
          "toolCallId": "call_1",
          "status": "completed",
          "content": [
            {
              "type": "content",
              "content": {
                "type": "text",
                "text": "ok\n"
              }
            }
          ],
          "rawOutput": {
            "type": "Bash",
            "output_for_prompt": "exit: 0\nok\n",
            "exit_code": 0,
            "command": "npm test | tee test.log",
            "truncated": false,
            "signal": null,
            "timed_out": false,
            "current_dir": "/Users/me/project",
            "total_bytes": 3
          }
        }
      ],
      "expected": {
        "call_1": {
          "status": "completed",
          "effects": [
            {
              "kind": "command",
              "command": "npm test | tee test.log",
              "cwd": "/Users/me/project",
              "exitCode": 0,
              "named": [
                "/Users/me/project/test.log"
              ],
              "background": true
            }
          ]
        }
      }
    },
    {
      "about": "A search_replace: Grok's diff shows only the replaced text, so the edit is its strings.",
      "records": [
        {
          "sessionUpdate": "tool_call",
          "toolCallId": "call_2",
          "title": "search_replace",
          "rawInput": {
            "file_path": "/Users/me/project/notes.md",
            "old_string": "ships on Friday",
            "new_string": "ships on Monday"
          },
          "_meta": {
            "x.ai/tool": {
              "version": 1,
              "name": "search_replace",
              "kind": "edit",
              "namespace": "grok_build",
              "label": "Edit",
              "read_only": false
            }
          }
        },
        {
          "sessionUpdate": "tool_call_update",
          "toolCallId": "call_2",
          "kind": "edit",
          "title": "Edit `/Users/me/project/notes.md`",
          "content": [
            {
              "type": "diff",
              "path": "/Users/me/project/notes.md",
              "oldText": "ships on Friday",
              "newText": "ships on Monday",
              "_meta": {
                "old_line": 1,
                "new_line": 1
              }
            }
          ],
          "locations": [
            {
              "path": "/Users/me/project/notes.md"
            }
          ],
          "rawInput": {
            "variant": "SearchReplace",
            "file_path": "/Users/me/project/notes.md",
            "old_string": "ships on Friday",
            "new_string": "ships on Monday",
            "replace_all": false
          }
        },
        {
          "sessionUpdate": "tool_call_update",
          "toolCallId": "call_2",
          "status": "completed",
          "content": [
            {
              "type": "diff",
              "path": "/Users/me/project/notes.md",
              "oldText": "ships on Friday",
              "newText": "ships on Monday"
            }
          ],
          "rawOutput": {
            "type": "SearchReplace",
            "EditsApplied": {
              "old_string": "ships on Friday",
              "new_string": "ships on Monday",
              "absolute_path": "/Users/me/project/notes.md"
            }
          }
        }
      ],
      "expected": {
        "call_2": {
          "status": "completed",
          "effects": [
            {
              "kind": "modify",
              "path": "/Users/me/project/notes.md",
              "edits": [
                {
                  "old": "ships on Friday",
                  "new": "ships on Monday"
                }
              ]
            }
          ]
        }
      }
    },
    {
      "about": "A write over a file: its diff holds the file before and after, a patch.",
      "records": [
        {
          "sessionUpdate": "tool_call",
          "toolCallId": "call_3",
          "title": "write",
          "rawInput": {
            "file_path": "/Users/me/project/notes.md",
            "content": "The release ships on Tuesday.\nQA signs off on Thursday.\n"
          },
          "_meta": {
            "x.ai/tool": {
              "version": 1,
              "name": "write",
              "kind": "edit",
              "namespace": "grok_build",
              "label": "Write",
              "read_only": false
            }
          }
        },
        {
          "sessionUpdate": "tool_call_update",
          "toolCallId": "call_3",
          "status": "completed",
          "content": [
            {
              "type": "diff",
              "path": "/Users/me/project/notes.md",
              "oldText": "The release ships on Monday.\nQA signs off on Thursday.\n",
              "newText": "The release ships on Tuesday.\nQA signs off on Thursday.\n"
            }
          ]
        }
      ],
      "expected": {
        "call_3": {
          "status": "completed",
          "effects": [
            {
              "kind": "modify",
              "path": "/Users/me/project/notes.md",
              "patch": "@@ -1,2 +1,2 @@\n-The release ships on Monday.\n+The release ships on Tuesday.\n QA signs off on Thursday.\n"
            }
          ]
        }
      }
    },
    {
