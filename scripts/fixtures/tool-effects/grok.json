            }
          }
        },
        {
          "sessionUpdate": "tool_call_update",
          "toolCallId": "call_5",
          "status": "completed",
          "content": [
            {
              "type": "content",
              "content": {
                "type": "text",
                "text": "1→The release ships on Tuesday.\n"
              }
            }
          ]
        }
      ],
      "expected": {
        "call_4": {
          "status": "completed",
          "effects": [
            {
              "kind": "write",
              "path": "/Users/me/project/todo.md",
              "content": "- ship\n"
            }
          ]
        },
        "call_5": {
          "status": "completed",
          "effects": [
            {
              "kind": "read",
              "path": "/Users/me/project/notes.md"
            }
          ]
        }
      }
    }
  ]
}
