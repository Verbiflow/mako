FROM node:24-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    libxkbcommon0 libx11-6 libxi6 libxtst6 libxext6 libssl3 \
    dbus-x11 xvfb openbox xauth x11-utils xdotool at-spi2-core sway grim \
    python3-gi python3-gi-cairo gir1.2-gtk-3.0 \
    fonts-noto-cjk fonts-noto-color-emoji ffmpeg ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN npm install --prefix /opt/mako-test --no-save --ignore-scripts sharp@0.35.3
ENV CUA_DRIVER_RS_TELEMETRY_ENABLED=0 NO_AT_BRIDGE=0 GTK_MODULES=gail:atk-bridge
WORKDIR /repo
