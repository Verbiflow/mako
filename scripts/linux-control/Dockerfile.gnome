FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    gnome-shell dbus-x11 dbus-user-session python3-gi python3-gi-cairo \
    gir1.2-gtk-3.0 at-spi2-core fonts-noto-cjk fonts-noto-color-emoji \
    libxkbcommon0 libxtst6 libxi6 libssl3 ffmpeg ca-certificates \
    mesa-utils libgl1-mesa-dri && rm -rf /var/lib/apt/lists/*
COPY --from=node:24-bookworm-slim /usr/local/bin/node /usr/local/bin/node
COPY --from=node:24-bookworm-slim /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm && \
    npm install --prefix /opt/mako-test --no-save --ignore-scripts sharp@0.35.3 && \
    mkdir -p /run/dbus && dbus-uuidgen --ensure
USER ubuntu
ENV NODE_PATH=/opt/mako-test/node_modules XDG_RUNTIME_DIR=/tmp/mako-gnome-runtime \
    XDG_SESSION_TYPE=wayland XDG_CURRENT_DESKTOP=GNOME GDK_BACKEND=wayland \
    LIBGL_ALWAYS_SOFTWARE=1 MUTTER_DEBUG_DUMMY_MODE_SPECS=1280x900 \
    CUA_DRIVER_RS_ENABLE_WAYLAND=1 CUA_DRIVER_RS_TELEMETRY_ENABLED=0 \
    NO_AT_BRIDGE=0 GTK_MODULES=gail:atk-bridge
