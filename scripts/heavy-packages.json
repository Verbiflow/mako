{
  "packages": [
    "@anthropic-ai/claude-agent-sdk",
    "@agentclientprotocol/sdk",
    "@modelcontextprotocol/sdk",
    "@mako/control-runtime/mcp",
    "ai",
    "@ai-sdk/",
    "ajv",
    "sharp",
    "ws",
    "yaml",
    "file-type",
    "@napi-rs/keyring"
  ],
  "declarations": [
    "packages/host/src/base/heavy-packages.ts",
    "packages/host/src/harnesses/heavy.ts",
    "packages/host/src/git/heavy.ts",
    "packages/control-runtime/src/heavy-packages.ts"
  ],
  "adapters": {
    "packages/host/src/git/utility-language.ts": {
      "uses": "the AI SDK and its providers",
      "loadedBy": [
        "packages/host/src/git/heavy.ts"
      ]
    },
    "packages/host/src/harnesses/acp-elicitation.ts": {
      "uses": "ACP's form schemas",
      "loadedBy": [
        "packages/host/src/harnesses/heavy.ts",
        "packages/host/src/harnesses/devin/approval-observer.ts"
      ]
    },
    "packages/host/src/harnesses/devin/approval-observer.ts": {
      "uses": "ACP's elicitation requests, reading Devin's approvals",
      "loadedBy": [
        "packages/host/src/harnesses/heavy.ts"
      ]
    },
    "packages/control-runtime/src/driver-schema.ts": {
      "uses": "MCP's ajv validator, for the computer driver's schemas",
      "loadedBy": [
        "packages/control-runtime/src/heavy-packages.ts"
      ]
    },
    "packages/control-runtime/src/control-mcp.ts": {
      "uses": "MCP's server SDK; loaded as @mako/control-runtime/mcp",
      "loadedBy": []
    },
    "electron/browser-tools-main.ts": {
      "uses": "MCP's server SDK, in its own process",
      "loadedBy": []
    },
    "electron/browser-native-host.ts": {
      "uses": "ws, in the browser extension's native host, a process started from browser-native-host-entry.ts",
      "loadedBy": [
        "electron/browser-native-host-entry.ts"
      ]
    },
    "packages/host/src/harnesses/claude/approval-settings-worker.ts": {
      "uses": "Claude's settings resolver, in its own worker thread",
      "loadedBy": []
    }
  }
}
