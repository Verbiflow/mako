diff --git a/libs/cua-driver/rust/crates/cua-driver-core/src/lib.rs b/libs/cua-driver/rust/crates/cua-driver-core/src/lib.rs
index e3d9f1c..45ae14a 100644
--- a/libs/cua-driver/rust/crates/cua-driver-core/src/lib.rs
+++ b/libs/cua-driver/rust/crates/cua-driver-core/src/lib.rs
@@ -37,6 +37,53 @@ pub fn embedded_mode() -> bool {
 /// Parent-EOF shutdown is valid only for a directly embedded daemon. Requiring
 /// both sentinels prevents an ambient variable from changing ordinary
 /// standalone or MCP stdin behavior.
+/// The key an embedding host shares with its daemon to tell it from another process holding the daemon's endpoint.
+pub const EMBEDDED_HOST_KEY_ENV: &str = "CUA_DRIVER_EMBEDDED_HOST_KEY";
+/// The pid of the host whose connections an embedded daemon serves.
+pub const EMBEDDED_HOST_PID_ENV: &str = "CUA_DRIVER_EMBEDDED_HOST_PID";
+
+/// What the host told its daemon about itself, held in memory only.
+struct EmbeddedHost {
+    key: Option<String>,
+    pid: Option<u32>,
+}
+static EMBEDDED_HOST: std::sync::OnceLock<EmbeddedHost> = std::sync::OnceLock::new();
+
+/// Read the host's key and pid once and take both out of this process's environment, so that nothing the daemon
+/// starts (a shell, the video helper, an app `launch_app` opens and whatever that app starts in turn) inherits them.
+/// Called first thing in `main` on Windows, before any thread or child exists; later calls change nothing.
+pub fn take_embedded_host_secrets() {
+    EMBEDDED_HOST.get_or_init(|| {
+        let host = EmbeddedHost {
+            key: std::env::var(EMBEDDED_HOST_KEY_ENV).ok().filter(|key| key.len() >= 32),
+            pid: std::env::var(EMBEDDED_HOST_PID_ENV).ok().and_then(|value| value.parse().ok()),
+        };
+        std::env::remove_var(EMBEDDED_HOST_KEY_ENV);
+        std::env::remove_var(EMBEDDED_HOST_PID_ENV);
+        host
+    });
+}
+
+/// The embedding host's pid, as it was given at startup.
+pub fn embedded_host_pid() -> Option<u32> {
+    take_embedded_host_secrets();
+    EMBEDDED_HOST.get().and_then(|host| host.pid)
+}
+
+/// HMAC-SHA256, in hex, of `challenge`, a line feed and `endpoint` under the host's key: what an embedded daemon
+/// answers a `prove` request with. The endpoint is the daemon's own (its pipe's name), so an answer is good for that
+/// endpoint alone. None without a key of at least 32 characters, so a daemon that was given none proves nothing.
+pub fn embedded_host_proof(challenge: &str, endpoint: &str) -> Option<String> {
+    use hmac::{Hmac, Mac};
+    take_embedded_host_secrets();
+    let key = EMBEDDED_HOST.get()?.key.as_deref()?;
+    let mut mac = Hmac::<sha2::Sha256>::new_from_slice(key.as_bytes()).ok()?;
+    mac.update(challenge.as_bytes());
+    mac.update(b"\n");
+    mac.update(endpoint.as_bytes());
+    Some(mac.finalize().into_bytes().iter().map(|byte| format!("{byte:02x}")).collect())
+}
+
 pub fn parent_liveness_stdin_enabled() -> bool {
     embedded_mode() && std::env::var_os(PARENT_LIVENESS_STDIN_ENV).is_some_and(|value| value == "1")
 }
