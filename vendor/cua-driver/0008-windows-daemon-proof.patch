+/// Whether a launch target names exactly one thing wherever the daemon runs: an absolute path on a drive or a share
+/// (after `%VAR%` references are expanded, as `list_apps` writes desktop apps' paths), or an item with a scheme
+/// (`shell:`, `https:`, `ms-settings:`). A single letter before the colon is a drive, so `C:tool.exe` is relative.
+fn launch_target_is_explicit(target: &str) -> bool {
+    let mut expanded = String::new();
+    let mut rest = target;
+    while let Some(start) = rest.find('%') {
+        let Some(length) = rest[start + 1..].find('%') else { break };
+        expanded.push_str(&rest[..start]);
+        match std::env::var(&rest[start + 1..start + 1 + length]) {
+            Ok(value) => expanded.push_str(&value),
+            Err(_) => expanded.push_str(&rest[start..start + length + 2]),
+        }
+        rest = &rest[start + length + 2..];
+    }
+    expanded.push_str(rest);
+    let bytes = expanded.as_bytes();
+    if expanded.starts_with("\\\\") || expanded.starts_with("//") {
+        return true;
+    }
+    if bytes.len() >= 2 && bytes[1] == b':' && bytes[0].is_ascii_alphabetic() {
+        return bytes.len() >= 3 && (bytes[2] == b'\\' || bytes[2] == b'/');
+    }
+    match expanded.find(':') {
+        Some(colon) if colon >= 2 => {
+            bytes[0].is_ascii_alphabetic() && bytes[..colon].iter().all(|byte| byte.is_ascii_alphanumeric() || matches!(byte, b'+' | b'.' | b'-'))
+        }
+        _ => false,
+    }
+}
+
+#[cfg(test)]
+mod launch_target_tests {
+    use super::launch_target_is_explicit;
+
+    #[test]
+    fn only_absolute_paths_and_schemes_are_explicit() {
+        for explicit in [r"C:\Windows\System32\notepad.exe", "C:/tools/app.exe", r"\\server\share\app.exe", r"shell:AppsFolder\Microsoft.WindowsCalculator_8wekyb3d8bbwe!App", "https://example.com", "ms-settings:display"] {
+            assert!(launch_target_is_explicit(explicit), "{explicit}");
+        }
+        for relative in ["notepad", "tool.exe", r"sub\tool.exe", r"..\x.exe", "./x.exe", "C:tool.exe", r"\Windows\notepad.exe", "", ":x", "1:x"] {
+            assert!(!launch_target_is_explicit(relative), "{relative}");
+        }
+    }
+}
