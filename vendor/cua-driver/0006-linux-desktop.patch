+/// A desktop entry string value's escapes (`\s`, `\n`, `\t`, `\r`, `\\`), undone before `Exec=` is split.
+fn unescape_value(value: &str) -> String {
+    let mut out = String::with_capacity(value.len());
+    let mut chars = value.chars();
+    while let Some(c) = chars.next() {
+        if c != '\\' {
+            out.push(c);
+            continue;
+        }
+        match chars.next() {
+            Some('s') => out.push(' '),
+            Some('n') => out.push('\n'),
+            Some('t') => out.push('\t'),
+            Some('r') => out.push('\r'),
+            Some('\\') => out.push('\\'),
+            Some(other) => {
+                out.push('\\');
+                out.push(other);
+            }
+            None => out.push('\\'),
+        }
+    }
+    out
+}
+
+/// A command line split as the desktop entry spec quotes `Exec=`: arguments separated by spaces, a double-quoted
+/// argument kept whole, and `\"`, `` \` ``, `\$` and `\\` inside quotes (and a backslash outside them) escaping
+/// the next character. `name` and `launch_path` both go through it, so an argument with spaces survives.
+pub(crate) fn exec_argv(command: &str) -> Vec<String> {
+    let mut args = Vec::new();
+    let mut current = String::new();
+    let mut started = false;
+    let mut quoted = false;
+    let mut chars = command.chars();
+    while let Some(c) = chars.next() {
+        match c {
+            '"' => {
+                quoted = !quoted;
+                started = true;
+            }
+            '\\' => {
+                if let Some(next) = chars.next() {
+                    if quoted && !matches!(next, '"' | '`' | '$' | '\\') {
+                        current.push('\\');
+                    }
+                    current.push(next);
+                    started = true;
+                }
+            }
+            c if c.is_whitespace() && !quoted => {
+                if started {
+                    args.push(std::mem::take(&mut current));
+                    started = false;
+                }
+            }
+            c => {
+                current.push(c);
+                started = true;
+            }
+        }
+    }
+    if started {
+        args.push(current);
+    }
+    args
+}
