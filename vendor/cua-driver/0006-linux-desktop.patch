+/// Session keys whose agent cursor was turned off (`set_agent_cursor_enabled(false)`). The Shell helper keeps no
+/// per-session state, so without this a later click re-showed a cursor its session had hidden.
+#[cfg(target_os = "linux")]
+static SHELL_CURSOR_OFF: std::sync::Mutex<Option<HashSet<CursorKey>>> = std::sync::Mutex::new(None);
+
+/// Whether the Shell helper may draw this session's cursor: the daemon has an overlay (not `--no-overlay`) and the
+/// session has not turned its cursor off.
+#[cfg(target_os = "linux")]
+fn shell_cursor_allowed(key: &str) -> bool {
+    let daemon_overlay = RENDER
+        .lock()
+        .ok()
+        .and_then(|guard| guard.as_ref().map(|map| map.template.enabled))
+        .unwrap_or(false);
+    daemon_overlay
+        && !SHELL_CURSOR_OFF
+            .lock()
+            .map(|off| off.as_ref().is_some_and(|keys| keys.contains(key)))
+            .unwrap_or(false)
+}
+
 #[cfg(target_os = "linux")]
 fn dispatch_shell_helper_command(key: &str, cmd: &OverlayCommand, semantic: bool) {
+    if let OverlayCommand::SetEnabled(enabled) = cmd {
+        if let Ok(mut off) = SHELL_CURSOR_OFF.lock() {
+            let keys = off.get_or_insert_with(HashSet::new);
+            if *enabled {
+                keys.remove(key);
+            } else {
+                keys.insert(key.to_owned());
+            }
+        }
+    }
+    if !shell_cursor_allowed(key) {
+        if matches!(cmd, OverlayCommand::SetEnabled(false)) {
+            crate::wayland::shell_helper::hide_cursor();
+        }
+        return;
+    }
     if semantic {
         crate::wayland::shell_helper::set_cursor_color(&cursor_overlay::session_fill_hex(key));
     }
