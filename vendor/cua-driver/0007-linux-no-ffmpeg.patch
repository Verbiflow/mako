diff --git a/libs/cua-driver/rust/crates/platform-linux/src/video_none.rs b/libs/cua-driver/rust/crates/platform-linux/src/video_none.rs
new file mode 100644
index 0000000..8be78a8
--- /dev/null
+++ b/libs/cua-driver/rust/crates/platform-linux/src/video_none.rs
@@ -0,0 +1,27 @@
+//! Linux records no video in the driver. Mako records a window (X11) or the monitor the person shares (Wayland)
+//! with its video helper, `mako-video`, and asks the driver only for its action journal (`record_video: false`).
+//! The FFmpeg-fed X11 and GNOME recorders that lived here are gone, and with them every `ffmpeg` this build ran.
+
+use std::path::Path;
+
+use cua_driver_core::video::{VideoBackend, VideoBackendFactory, WindowVideoTarget};
+
+const REFUSAL: &str = "This Linux build records no video itself: record through Mako, whose video helper \
+    (mako-video) captures the window or the shared screen. No capture was started";
+
+pub struct NoVideoBackendFactory;
+
+impl VideoBackendFactory for NoVideoBackendFactory {
+    fn start(&self, _output_path: &Path) -> anyhow::Result<Box<dyn VideoBackend>> {
+        anyhow::bail!(REFUSAL)
+    }
+
+    fn start_window(
+        &self,
+        _output_path: &Path,
+        _target: WindowVideoTarget,
+        _fps: u32,
+    ) -> anyhow::Result<Box<dyn VideoBackend>> {
+        anyhow::bail!(REFUSAL)
+    }
+}
