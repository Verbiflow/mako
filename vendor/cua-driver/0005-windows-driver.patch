diff --git a/libs/cua-driver/rust/crates/platform-windows/src/video_helper.rs b/libs/cua-driver/rust/crates/platform-windows/src/video_helper.rs
new file mode 100644
index 0000000..36e8cbc
--- /dev/null
+++ b/libs/cua-driver/rust/crates/platform-windows/src/video_helper.rs
@@ -0,0 +1,264 @@
+//! Exact-window video on Windows without FFmpeg: Mako's video helper (`mako-video.exe`: Windows Graphics Capture into
+//! Media Foundation's H.264 encoder) captures the window, and its units are written here as fragmented MP4, the file
+//! Mako's runtime writes from the same units. The helper is run by the whole path the host gives in
+//! `CUA_DRIVER_VIDEO_HELPER`, never looked up on `PATH` or in the current directory; without one, window video is
+//! refused before anything starts. Whole-display video is not recorded on Windows.
+//!
+//! The helper sends a unit only when the window's pixels change, so the video has a variable rate, as on a Mac. The
+//! last unit lasts until the recording stops. A window that closes ends the recording with the helper's reason; one
+//! that changes size ends it at the last unit before the change (the encoder's configuration changed), and the
+//! video kept so far is finalized either way.
+
+use cua_driver_core::video::{VideoBackend, VideoBackendFactory, VideoMetadata, WindowVideoTarget};
+use cua_driver_core::video_fmp4::{read_unit, ConfigurationChanged, Fmp4Writer};
+use std::io::{BufReader, Read};
+use std::os::windows::process::CommandExt;
+use std::path::{Path, PathBuf};
+use std::process::{Child, ChildStdin, Command, Stdio};
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::{mpsc, Arc, Mutex};
+use std::time::{Duration, SystemTime, UNIX_EPOCH};
+use windows::Win32::Foundation::HWND;
+use windows::Win32::UI::WindowsAndMessaging::{GetWindowThreadProcessId, IsWindow};
+
+/// Where the host puts the helper's whole path.
+pub const VIDEO_HELPER_ENV: &str = "CUA_DRIVER_VIDEO_HELPER";
+/// The quality recordings ask the helper for, as Mako's own recordings do (`RECORDING_QUALITY`).
+const RECORDING_QUALITY: u32 = 85;
+const CREATE_NO_WINDOW: u32 = 0x0800_0000;
+
+static ACTIVE: AtomicBool = AtomicBool::new(false);
+struct Admission;
+impl Drop for Admission {
+    fn drop(&mut self) {
+        ACTIVE.store(false, Ordering::Release);
+    }
+}
+
+/// The helper's whole path, or why there is none.
+fn helper_path() -> anyhow::Result<PathBuf> {
+    let configured = std::env::var_os(VIDEO_HELPER_ENV).map(PathBuf::from).ok_or_else(|| {
+        anyhow::anyhow!("Window video needs Mako's video helper; its host gives the helper's whole path in {VIDEO_HELPER_ENV}. No capture was started")
+    })?;
+    if !configured.is_absolute() || !configured.is_file() {
+        anyhow::bail!("{VIDEO_HELPER_ENV} must be the whole path of an existing mako-video.exe; no capture was started");
+    }
+    Ok(configured)
+}
+
+fn now_ms() -> f64 {
+    SystemTime::now().duration_since(UNIX_EPOCH).map(|elapsed| elapsed.as_secs_f64() * 1000.0).unwrap_or(0.0)
+}
+
+pub struct HelperVideoBackendFactory;
+
+impl VideoBackendFactory for HelperVideoBackendFactory {
+    fn start(&self, _path: &Path) -> anyhow::Result<Box<dyn VideoBackend>> {
+        anyhow::bail!("Whole-display video isn't recorded on Windows; record one window (window_target). No capture was started")
+    }
+
+    fn max_window_fps(&self) -> u32 {
+        60
+    }
+
+    fn start_window(&self, path: &Path, target: WindowVideoTarget, fps: u32) -> anyhow::Result<Box<dyn VideoBackend>> {
+        if path.exists() {
+            anyhow::bail!("Recording output exists; choose a new directory");
+        }
+        let hwnd = HWND(target.window_id as usize as *mut _);
+        let mut owner = 0u32;
+        if !unsafe { IsWindow(hwnd) }.as_bool()
+            || unsafe { GetWindowThreadProcessId(hwnd, Some(&mut owner)) } == 0
+            || i64::from(owner) != i64::from(target.pid)
+        {
+            anyhow::bail!("Window {} does not belong to pid {}; no capture was started", target.window_id, target.pid);
+        }
+        let helper = helper_path()?;
+        if ACTIVE.compare_exchange(false, true, Ordering::AcqRel, Ordering::Acquire).is_err() {
+            anyhow::bail!("A previous window recording still owns capture");
+        }
+        let admission = Admission;
+        if let Some(parent) = path.parent() {
+            std::fs::create_dir_all(parent)?;
+        }
+        let mut child = Command::new(&helper)
+            .args([
+                "window".to_string(),
+                target.window_id.to_string(),
+                "--fps".into(),
+                fps.to_string(),
+                "--keyint".into(),
+                fps.to_string(),
+                "--quality".into(),
+                RECORDING_QUALITY.to_string(),
+            ])
+            .current_dir(helper.parent().unwrap_or(Path::new("\\")))
+            .stdin(Stdio::piped())
+            .stdout(Stdio::piped())
+            .stderr(Stdio::piped())
+            .creation_flags(CREATE_NO_WINDOW)
+            .spawn()
+            .map_err(|error| anyhow::anyhow!("The video helper couldn't start: {error}"))?;
+        let stdout = child.stdout.take().ok_or_else(|| anyhow::anyhow!("Missing video helper output"))?;
+        let mut stderr = child.stderr.take().ok_or_else(|| anyhow::anyhow!("Missing video helper diagnostics"))?;
+        let stdin = Arc::new(Mutex::new(child.stdin.take()));
+        let child = Arc::new(Mutex::new(child));
+        let diagnostics = std::thread::spawn(move || {
+            let mut tail = Vec::new();
+            let mut buffer = [0u8; 4096];
+            while let Ok(read) = stderr.read(&mut buffer) {
+                if read == 0 {
+                    break;
+                }
+                tail.extend_from_slice(&buffer[..read]);
+                if tail.len() > 8192 {
+                    tail.drain(..tail.len() - 8192);
+                }
+            }
+            String::from_utf8_lossy(&tail).into_owned()
+        });
+        let stopped = Arc::new(AtomicBool::new(false));
+        let finished = Arc::new(AtomicBool::new(false));
+        let (ready_tx, ready) = mpsc::sync_channel::<Result<(), String>>(1);
+        let (done_tx, done) = mpsc::sync_channel(1);
+        let output = path.to_path_buf();
+        let frame_ms = 1000.0 / f64::from(fps);
+        let worker_stopped = stopped.clone();
+        let worker_finished = finished.clone();
+        let worker_stdin = stdin.clone();
+        std::thread::spawn(move || {
+            let _admission = admission;
+            let result = record(output, frame_ms, stdout, diagnostics, &worker_stopped, &worker_stdin, &ready_tx);
+            if let Err(error) = &result {
+                let _ = ready_tx.try_send(Err(error.to_string()));
+            }
+            worker_finished.store(true, Ordering::Release);
+            let _ = done_tx.send(result);
+        });
+        let recording = Recording { stdin, child, stopped, finished, done };
+        match ready.recv_timeout(Duration::from_secs(10)) {
+            Ok(Ok(())) => Ok(Box::new(recording)),
+            Ok(Err(error)) => anyhow::bail!(error),
+            Err(_) => {
+                recording.end();
+                anyhow::bail!("The window's first frame did not come within 10 s; no recording was kept")
+            }
+        }
+    }
+}
+
+fn record(
+    path: PathBuf,
+    frame_ms: f64,
+    stdout: std::process::ChildStdout,
+    diagnostics: std::thread::JoinHandle<String>,
+    stopped: &AtomicBool,
+    stdin: &Mutex<Option<ChildStdin>>,
+    ready: &mpsc::SyncSender<Result<(), String>>,
+) -> anyhow::Result<VideoMetadata> {
+    let mut writer = Fmp4Writer::new(&path, frame_ms);
+    let mut input = BufReader::with_capacity(1 << 20, stdout);
+    let mut interruption = None;
+    let mut announced = false;
+    loop {
+        let unit = match read_unit(&mut input) {
+            Ok(Some(unit)) => unit,
+            Ok(None) => break,
+            Err(error) => {
+                interruption = Some(error.to_string());
+                break;
+            }
+        };
+        let at = unit.captured_at;
+        match writer.add(unit, at) {
+            Ok(()) => {}
+            Err(error) if error.is::<ConfigurationChanged>() => {
+                interruption = Some("The window changed size; the recording ends at its last frame before the change".into());
+                break;
+            }
+            Err(error) => {
+                interruption = Some(format!("Writing the recording failed: {error}"));
+                break;
+            }
+        }
+        if !announced {
+            let _ = ready.send(Ok(()));
+            announced = true;
+        }
+    }
+    // Stopped, or the source ended: the helper's input closes either way, and its diagnostics say why it ended.
+    drop(stdin.lock().unwrap().take());
+    let ended_at = now_ms();
+    let tail = diagnostics.join().unwrap_or_default();
+    if interruption.is_none() && !stopped.load(Ordering::Acquire) {
+        interruption = Some(
+            tail.lines()
+                .find_map(|line| line.strip_prefix("ended: ").map(str::to_owned))
+                .unwrap_or_else(|| "The video helper stopped".into()),
+        );
+    }
+    let last = writer.held_at().map(|at| ended_at - at);
+    writer.finish(last)?;
+    if writer.frames() == 0 {
+        let _ = std::fs::remove_file(&path);
+        anyhow::bail!(
+            "{}; no frame was recorded",
+            interruption.as_deref().unwrap_or("The window's capture produced no frame")
+        );
+    }
+    Ok(VideoMetadata {
+        path,
+        duration_ms: writer.duration_ms().round() as u64,
+        finalized: true,
+        interruption,
+    })
+}
+
+struct Recording {
+    stdin: Arc<Mutex<Option<ChildStdin>>>,
+    child: Arc<Mutex<Child>>,
+    stopped: Arc<AtomicBool>,
+    finished: Arc<AtomicBool>,
+    done: mpsc::Receiver<anyhow::Result<VideoMetadata>>,
+}
+
+impl Recording {
+    /// The helper stops when its input ends; one that doesn't within three seconds is terminated.
+    fn end(&self) {
+        self.stopped.store(true, Ordering::Release);
+        drop(self.stdin.lock().unwrap().take());
+        let child = self.child.clone();
+        std::thread::spawn(move || {
+            for _ in 0..30 {
+                if matches!(child.lock().unwrap().try_wait(), Ok(Some(_))) {
+                    return;
+                }
+                std::thread::sleep(Duration::from_millis(100));
+            }
+            let mut child = child.lock().unwrap();
+            let _ = child.kill();
+            let _ = child.wait();
+        });
+    }
+}
+
+impl Drop for Recording {
+    fn drop(&mut self) {
+        if !self.stopped.load(Ordering::Acquire) {
+            self.end();
+        }
+    }
+}
+
+impl VideoBackend for Recording {
+    fn is_recording(&self) -> bool {
+        !self.finished.load(Ordering::Acquire)
+    }
+
+    fn stop(self: Box<Self>) -> anyhow::Result<VideoMetadata> {
+        self.end();
+        self.done
+            .recv_timeout(Duration::from_secs(10))
+            .map_err(|_| anyhow::anyhow!("Window recording cleanup is still pending"))?
+    }
