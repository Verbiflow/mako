+/// The most text a Win32 edit's TextPattern read returns, as the Linux driver's AT-SPI text read.
+const MAX_EDIT_TEXT: i32 = 100_000;
+
+/// The element's value and whether it is exact. A ValuePattern control's value is read as it is, empty and
+/// whitespace included; a password field's never is. A Win32 edit or rich edit that has no ValuePattern (Notepad's
+/// editor) holds its text in TextPattern, read whole up to `MAX_EDIT_TEXT`. Anything else keeps the display reading.
+fn read_cached_value(element: &IUIAutomationElement, control_type: &str) -> (Option<String>, bool) {
+    if read_cached_bool(element, UIA_IsPasswordPropertyId) == Some(true) {
+        return (None, false);
+    }
+    unsafe {
+        if element.GetCachedPattern(UIA_ValuePatternId).is_ok() {
+            if let Some(raw) = read_cached_bstr_raw(element, UIA_ValueValuePropertyId) {
+                return (Some(raw), true);
+            }
+        } else if is_win32_edit(element, control_type) {
+            if let Some((text, exact)) = read_edit_text(element) {
+                return (Some(text), exact);
+            }
+        }
+    }
+    (read_cached_bstr_value(element), false)
+}
+
+/// An Edit control, or a Document that is a Win32 edit or rich edit: never a browser's page, whose Document holds the
+/// whole page's text.
+fn is_win32_edit(element: &IUIAutomationElement, control_type: &str) -> bool {
+    match control_type {
+        "Edit" => true,
+        "Document" => read_cached_bstr(element, UIA_ClassNamePropertyId)
+            .is_some_and(|class| class.eq_ignore_ascii_case("Edit") || class.to_ascii_lowercase().starts_with("richedit")),
+        _ => false,
+    }
+}
+
+/// The text of an edit through its TextPattern: one cross-process read, made only for edits without a ValuePattern.
+unsafe fn read_edit_text(element: &IUIAutomationElement) -> Option<(String, bool)> {
+    let pattern = element
+        .GetCachedPattern(UIA_TextPatternId)
+        .ok()?
+        .cast::<IUIAutomationTextPattern>()
+        .ok()?;
+    let range = pattern.DocumentRange().ok()?;
+    let text = range.GetText(MAX_EDIT_TEXT + 1).ok()?.to_string();
+    let length = text.encode_utf16().count() as i32;
+    if length > MAX_EDIT_TEXT {
+        let cut: String = String::from_utf16_lossy(&text.encode_utf16().take(MAX_EDIT_TEXT as usize).collect::<Vec<u16>>());
+        return Some((cut, false));
+    }
+    Some((text, true))
+}
+
+/// A BSTR property as the provider gave it, empty and whitespace included.
+fn read_cached_bstr_raw(
+    element: &IUIAutomationElement,
+    property_id: windows::Win32::UI::Accessibility::UIA_PROPERTY_ID,
+) -> Option<String> {
+    unsafe {
+        let variant = element.GetCachedPropertyValue(property_id).ok()?;
+        if variant.as_raw().Anonymous.Anonymous.vt == 8 {
+            let bstr = BSTR::from_raw(variant.as_raw().Anonymous.Anonymous.Anonymous.bstrVal);
+            let s = bstr.to_string();
+            std::mem::forget(bstr);
+            Some(s)
+        } else {
+            None
+        }
+    }
+}
