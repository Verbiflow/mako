+
+/// A Unicode window's WM_CHAR carries one UTF-16 unit: a character past U+FFFF (an emoji, a CJK extension) goes as
+/// its surrogate pair, high then low, as a keyboard's input does. Its whole code point in one message is dropped.
+unsafe fn post_char_units(h: HWND, ch: char) -> Result<()> {
+    let mut units = [0u16; 2];
+    for unit in ch.encode_utf16(&mut units) {
+        PostMessageW(h, WM_CHAR, WPARAM(*unit as usize), LPARAM(1))?;
     }
     Ok(())
 }
