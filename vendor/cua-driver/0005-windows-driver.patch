diff --git a/libs/cua-driver/rust/crates/cua-driver-core/src/system_program.rs b/libs/cua-driver/rust/crates/cua-driver-core/src/system_program.rs
new file mode 100644
index 0000000..7bf52a1
--- /dev/null
+++ b/libs/cua-driver/rust/crates/cua-driver-core/src/system_program.rs
@@ -0,0 +1,16 @@
+//! Windows programs the driver runs, by their whole path in the system directory. A bare name would be looked up
+//! beside the driver's own executable before the system directory, and on `PATH` after it, so a file planted in
+//! either could run in its place.
+
+use std::path::PathBuf;
+
+/// `relative` (e.g. `cmd.exe`, `WindowsPowerShell\v1.0\powershell.exe`) under the system directory, as
+/// `GetSystemDirectoryW` gives it rather than as an environment variable says.
+pub fn system_program(relative: &str) -> std::io::Result<PathBuf> {
+    let mut buffer = [0u16; 32768];
+    let length = unsafe { windows::Win32::System::SystemInformation::GetSystemDirectoryW(Some(&mut buffer)) } as usize;
+    if length == 0 || length >= buffer.len() {
+        return Err(std::io::Error::other("could not resolve the Windows system directory"));
+    }
+    Ok(PathBuf::from(String::from_utf16_lossy(&buffer[..length])).join(relative))
+}
