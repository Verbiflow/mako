--- /dev/null
+++ b/libs/cua-driver/rust/crates/platform-macos/src/ax/read_budget.rs
@@ -0,0 +1,160 @@
+//! Per-walk deadline and coverage shared by all synchronous AX reads.
+use std::{
+    cell::RefCell,
+    sync::{
+        atomic::{AtomicBool, Ordering},
+        Arc,
+    },
+    time::{Duration, Instant},
+};
+
+#[derive(Clone)]
+struct Budget {
+    deadline: Instant,
+    cancelled: Arc<AtomicBool>,
+    incomplete: bool,
+}
+thread_local! { static CURRENT: RefCell<Option<Budget>> = const { RefCell::new(None) }; }
+
+pub struct CancelRead(pub Arc<AtomicBool>);
+impl Drop for CancelRead {
+    fn drop(&mut self) {
+        self.0.store(true, Ordering::Release);
+    }
+}
+
+pub fn within<T>(
+    deadline: Instant,
+    cancelled: Arc<AtomicBool>,
+    read: impl FnOnce() -> T,
+) -> (T, bool) {
+    struct Restore(Option<Budget>);
+    impl Drop for Restore {
+        fn drop(&mut self) {
+            CURRENT.with(|slot| {
+                *slot.borrow_mut() = self.0.take();
+            });
+        }
+    }
+    let previous = CURRENT.with(|slot| {
+        slot.replace(Some(Budget {
+            deadline,
+            cancelled,
+            incomplete: false,
+        }))
+    });
+    let _restore = Restore(previous);
+    let result = read();
+    let complete = CURRENT.with(|slot| {
+        slot.borrow().as_ref().is_some_and(|b| {
+            !b.incomplete && !b.cancelled.load(Ordering::Acquire) && Instant::now() < b.deadline
+        })
+    });
+    (result, complete)
+}
+
+pub fn remaining() -> Option<Duration> {
+    CURRENT.with(|slot| {
+        let mut state = slot.borrow_mut();
+        let Some(budget) = state.as_mut() else {
+            return Some(Duration::from_secs(2));
+        };
+        let left = budget.deadline.saturating_duration_since(Instant::now());
+        if budget.cancelled.load(Ordering::Acquire) || left.is_zero() {
+            budget.incomplete = true;
+            None
+        } else {
+            Some(left.min(Duration::from_secs(2)))
+        }
+    })
+}
+pub fn failed() {
+    CURRENT.with(|slot| {
+        if let Some(b) = slot.borrow_mut().as_mut() {
+            b.incomplete = true;
+        }
+    });
+}
+pub fn error(code: i32) {
+    // Unsupported attributes and absent optional values are valid evidence.
+    if !matches!(code, 0 | -25205 | -25212) {
+        failed();
+    }
+}
+
+/// AppKit NSTextView can return generic failure for an absent AXIdentifier.
+/// This optional identity hint is not a node, name, value, or search field;
+/// its absence must not turn an otherwise complete window into a partial tree.
+/// Invalid elements, communication failures and all search-field errors remain
+/// coverage failures. Deadlines are checked independently before every call.
+pub fn attribute_error(attribute: &str, code: i32) {
+    if attribute == "AXIdentifier" && code == -25200 {
+        return;
+    }
+    error(code);
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn cancellation_stops_reads_and_marks_coverage() {
+        let cancel = Arc::new(AtomicBool::new(false));
+        let (_, complete) = within(
+            Instant::now() + Duration::from_secs(1),
+            cancel.clone(),
+            || {
+                assert!(remaining().is_some());
+                cancel.store(true, Ordering::Release);
+                assert!(remaining().is_none());
+            },
+        );
+        assert!(!complete);
+        assert!(remaining().is_some());
+    }
+    #[test]
+    fn errors_are_not_empty_complete_trees() {
+        let run = |code| {
+            within(
+                Instant::now() + Duration::from_secs(1),
+                Arc::new(AtomicBool::new(false)),
+                || error(code),
+            )
+            .1
+        };
+        assert!(run(-25205));
+        assert!(run(-25212));
+        assert!(!run(-25204));
+        assert!(!run(-25202));
+    }
+    #[test]
+    fn optional_identity_hint_failure_does_not_hide_search_coverage() {
+        let complete = |attribute, code| {
+            within(
+                Instant::now() + Duration::from_secs(1),
+                Arc::new(AtomicBool::new(false)),
+                || attribute_error(attribute, code),
+            )
+            .1
+        };
+        assert!(complete("AXIdentifier", -25200));
+        for attribute in [
+            "AXChildren",
+            "AXRole",
+            "AXTitle",
+            "AXDescription",
+            "AXValue",
+        ] {
+            assert!(!complete(attribute, -25200));
+        }
+        assert!(!complete("AXIdentifier", -25204));
+        assert!(!complete("AXIdentifier", -25202));
+    }
+    #[test]
+    fn elapsed_deadline_refuses_native_call() {
+        let (_, complete) = within(Instant::now(), Arc::new(AtomicBool::new(false)), || {
+            assert!(remaining().is_none())
+        });
+        assert!(!complete);
+    }
+}
