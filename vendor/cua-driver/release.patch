+++ b/libs/cua-driver/rust/crates/cua-driver-core/tests/window_video_rate.rs
@@ -0,0 +1,41 @@
+use cua_driver_core::{
+    recording::RecordingSession,
+    video::{self, VideoBackend, VideoBackendFactory, WindowVideoTarget},
+};
+use std::{path::Path, sync::{Arc, Mutex}};
+struct Factory(Arc<Mutex<Vec<u32>>>);
+impl VideoBackendFactory for Factory {
+    fn start(&self, _: &Path) -> anyhow::Result<Box<dyn VideoBackend>> { panic!("must not widen scope") }
+    fn max_window_fps(&self) -> u32 { 60 }
+    fn start_window(&self, _: &Path, _: WindowVideoTarget, fps: u32) -> anyhow::Result<Box<dyn VideoBackend>> {
+        self.0.lock().unwrap().push(fps);
+        anyhow::bail!("fixture: source unavailable")
+    }
+}
+#[test]
+fn source_rate_validation_and_recording_identity() {
+    let calls = Arc::new(Mutex::new(Vec::new()));
+    video::set_video_backend_factory(Box::new(Factory(calls.clone())));
+    let target = WindowVideoTarget { pid: 42, window_id: 7 };
+    for fps in [0, 61, u32::MAX] {
+        assert!(video::start_window_video(Path::new("unused"), target, fps).is_err());
+    }
+    assert!(calls.lock().unwrap().is_empty(), "invalid rates refuse before backend dispatch");
+    for fps in [1, 30, 60] {
+        assert!(video::start_window_video(Path::new("unused"), target, fps).is_err());
+    }
+    assert_eq!(*calls.lock().unwrap(), [1, 30, 60]);
+    let dir = tempfile::tempdir().unwrap();
+    let output = dir.path().join("recording");
+    let session = RecordingSession::new();
+    let start = |fps| session.start_identified(output.to_str().unwrap(), false, Some("rate-owner"), Some(target), false, Some("rate-id"), fps);
+    assert!(start(61).is_err());
+    assert!(!output.exists(), "invalid rate creates no files");
+    start(60).unwrap();
+    let generation = session.current_state().generation;
+    assert_eq!(session.current_state().fps, 60);
+    start(60).unwrap();
+    assert_eq!(session.current_state().generation, generation);
+    assert!(start(30).is_err(), "same recording id cannot silently change capture rate");
+    session.stop_identified(Some("rate-owner"), "rate-id").unwrap();
+}
