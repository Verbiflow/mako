@@ -0,0 +1,83 @@
+//! Shared native action settling without changing action-success semantics.
+use crate::ax::activity::{unavailable, Monitor, MONITORED_ACTION};
+use async_trait::async_trait;
+use cua_driver_core::{
+    protocol::ToolResult,
+    tool::{ProtectedResourceOwnership, Tool, ToolDef},
+};
+use serde_json::Value;
+
+pub(super) struct SettledTool(pub Box<dyn Tool>);
+#[async_trait]
+impl Tool for SettledTool {
+    fn def(&self) -> &ToolDef {
+        self.0.def()
+    }
+    fn has_independent_input_lane(&self, args: &Value) -> bool {
+        self.0.has_independent_input_lane(args)
+    }
+    async fn protected_resource_ownership(
+        &self,
+        adapter: &str,
+        args: &Value,
+    ) -> ProtectedResourceOwnership {
+        self.0.protected_resource_ownership(adapter, args).await
+    }
+    async fn protected_resource_scope(
+        &self,
+        adapter: &str,
+        args: &Value,
+    ) -> Result<Option<Value>, String> {
+        self.0.protected_resource_scope(adapter, args).await
+    }
+    async fn validate_protected_resource_scope(
+        &self,
+        adapter: &str,
+        args: &Value,
+        scope: &Value,
+    ) -> Result<(), String> {
+        self.0
+            .validate_protected_resource_scope(adapter, args, scope)
+            .await
+    }
+    async fn invoke(&self, args: Value) -> ToolResult {
+        let pid = args
+            .get("pid")
+            .and_then(Value::as_i64)
+            .and_then(|p| i32::try_from(p).ok())
+            .filter(|p| *p > 0);
+        let Some(pid) = pid else {
+            return self.0.invoke(args).await;
+        };
+        if args.get("scope").and_then(Value::as_str) == Some("desktop")
+            || self.def().name == "bring_to_front"
+        {
+            return self.0.invoke(args).await;
+        }
+        let monitor = Monitor::start(pid).await;
+        let prior = crate::apps::frontmost_pid();
+        let background = args.get("delivery_mode").and_then(Value::as_str) != Some("foreground");
+        // Keep a targeted lease through observed settling, never a desktop wildcard.
+        let lease = if background {
+            prior
+                .filter(|p| *p != pid)
+                .map(|p| crate::focus_steal::begin_suppression(Some(pid), p, "action.settling"))
+        } else {
+            None
+        };
+        let mut result = MONITORED_ACTION
+            .scope(monitor.is_some(), self.0.invoke(args))
+            .await;
+        // A refusal is not dispatched work; do not delay it or invent success.
+        if result.is_error == Some(true) {
+            return result;
+        }
+        let settling = match monitor {
+            Some(ref monitor) => monitor.finish().await,
+            None => unavailable(),
+        };
+        result.settling = Some(settling);
+        result.focus_change = lease.as_ref().and_then(|lease| lease.focus_change());
+        result
+    }
+}
