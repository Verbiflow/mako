+}
+
+/// Propagate the recording scope into an input worker without doing media IO.
+pub fn spawn_blocking<F, R>(work: F) -> tokio::task::JoinHandle<R>
+where
+    F: FnOnce() -> R + Send + 'static,
+    R: Send + 'static,
+{
+    let scope = DISPATCH_CLICK_SCOPE.try_with(Clone::clone).ok().flatten();
+    tokio::task::spawn_blocking(move || {
+        struct Restore(Option<Arc<DispatchClickScope>>);
+        impl Drop for Restore {
+            fn drop(&mut self) {
+                BLOCKING_DISPATCH_SCOPE.with(|slot| {
+                    slot.replace(self.0.take());
+                });
+            }
+        }
+        let _restore = Restore(BLOCKING_DISPATCH_SCOPE.with(|slot| slot.replace(scope)));
+        work()
+    })
+}
+
+pub fn recording_target_pid(window_id: u64) -> Option<i64> {
+    let scope = BLOCKING_DISPATCH_SCOPE
+        .with(|slot| slot.borrow().clone())
+        .or_else(|| DISPATCH_CLICK_SCOPE.try_with(Clone::clone).ok().flatten())?;
+    (scope.window_id == window_id).then_some(scope.pid)
+}
+
+/// Exact target of this owned input dispatch, never a global/first window.
+pub fn recording_dispatch_target() -> Option<(u64, i64)> {
+    let scope = BLOCKING_DISPATCH_SCOPE
+        .with(|slot| slot.borrow().clone())
+        .or_else(|| DISPATCH_CLICK_SCOPE.try_with(Clone::clone).ok().flatten())?;
+    Some((scope.window_id, scope.pid))
+}
+
+/// An owned dispatch recorder that can cross a dedicated native worker queue.
+/// Capturing it performs no image or geometry IO and never creates a recording.
+#[derive(Clone)]
+pub struct PointerRecorder(Arc<DispatchClickScope>);
+
+impl PointerRecorder {
+    pub fn capture(window_id: u64, pid: i64) -> Option<Self> {
+        let scope = BLOCKING_DISPATCH_SCOPE
+            .with(|slot| slot.borrow().clone())
+            .or_else(|| DISPATCH_CLICK_SCOPE.try_with(Clone::clone).ok().flatten())?;
+        ((scope.window_id, scope.pid) == (window_id, pid)).then_some(Self(scope))
+    }
+
+    /// Record native dispatch, not confirmation that an application accepted it.
+    pub fn record(&self, x: f64, y: f64, pressed: bool) {
+        if !(0.0..=1.0).contains(&x) || !(0.0..=1.0).contains(&y) {
+            return;
+        }
+        let dispatched_at = now_ms();
+        let mut capture = self.0.capture.lock().unwrap();
+        if capture.pointer_dispatches.len() < 2048 {
+            capture
+                .pointer_dispatches
+                .push(serde_json::json!({"at_ms":dispatched_at,"x":x,"y":y,"pressed":pressed}));
+        }
+    }
+}
+
+/// Called after a native mouse event is posted. Geometry is evaluated only for
+/// the exact window owned by an active recording.
+pub fn record_pointer_dispatch(
+    window_id: u64,
+    pid: i64,
+    point: impl FnOnce() -> Option<(f64, f64)>,
+    pressed: bool,
+) {
+    let Some(recorder) = PointerRecorder::capture(window_id, pid) else {
+        return;
+    };
+    if let Some((x, y)) = point() {
+        recorder.record(x, y, pressed);
+    }
+}
