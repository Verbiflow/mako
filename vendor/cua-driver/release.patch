+/// A snapshot's bus/path and owning window survive sibling reordering. A
+/// destroyed or moved object is refused; labels and ordinal positions cannot
+/// retarget a mutation.
+fn retained_target<'a, 'b>(
+    visited: &'b [Visited<'a>],
+    idx: usize,
+    identity: Option<&NodeIdentity>,
+) -> Result<&'b Visited<'a>> {
+    if let Some(identity) = identity {
+        let target = visited
+            .iter()
+            .find(|v| v.object.name == identity.bus && v.object.path == identity.path)
+            .ok_or_else(|| {
+                anyhow!("stale_element_identity: observed accessibility object no longer exists")
+            })?;
+        let root = visited
+            .iter()
+            .find(|v| v.depth == 0 && v.frame_ordinal == target.frame_ordinal)
+            .ok_or_else(|| anyhow!("stale_element_identity: owning window is unavailable"))?;
+        if root.object.name != identity.window_bus
+            || root.object.path != identity.window_path
+            || !is_indexable(target)
+        {
+            return Err(anyhow!(
+                "stale_element_identity: observed control moved or is no longer operable"
+            ));
+        }
+        if visited
+            .iter()
+            .any(|node| node.depth == 0 && node.modal && node.frame_ordinal != target.frame_ordinal)
+        {
+            return Err(anyhow!("modal_window_blocks_target: inspect the application's modal window before changing its parent"));
+        }
+        return Ok(target);
+    }
+    visited
+        .iter()
+        .filter(|v| is_indexable(v))
+        .nth(idx)
+        .ok_or_else(|| anyhow!("element {idx} not found"))
+}
