@@ -0,0 +1,42 @@
+//! Recording metadata follows the actual input command onto native workers.
+use cua_driver_core::recording::{recording_dispatch_target, PointerRecorder};
+
+pub(super) struct PointerCapture {
+    recorder: PointerRecorder,
+    bounds: (f64, f64, f64, f64),
+}
+impl PointerCapture {
+    pub(super) fn current() -> Option<Self> {
+        let (id, pid) = recording_dispatch_target()?;
+        let recorder = PointerRecorder::capture(id, pid)?;
+        let pid = u32::try_from(pid).ok()?;
+        let bounds = if let Some(window) = super::sway_ipc::window_for_id(id) {
+            if window.pid != pid {
+                return None;
+            }
+            (window.x, window.y, window.width, window.height)
+        } else {
+            let window = super::shell_helper::trusted_window_for_id(pid, id)?;
+            (window.x, window.y, window.width, window.height)
+        };
+        if bounds.2 == 0 || bounds.3 == 0 {
+            return None;
+        }
+        Some(Self {
+            recorder,
+            bounds: (
+                bounds.0.into(),
+                bounds.1.into(),
+                bounds.2.into(),
+                bounds.3.into(),
+            ),
+        })
+    }
+    pub(super) fn record(&self, x: f64, y: f64, pressed: bool) {
+        self.recorder.record(
+            (x - self.bounds.0) / self.bounds.2,
+            (y - self.bounds.1) / self.bounds.3,
+            pressed,
+        );
+    }
+}
