+++ b/libs/cua-driver/rust/crates/platform-macos/src/ax/activity.rs
@@ -0,0 +1,306 @@
+//! Bounded process-level AX activity observation. Quiet events are not an action
+//! postcondition: apps may omit notifications or schedule work after this window.
+use super::bindings::{
+    AXUIElementCreateApplication, AXUIElementRef, AXUIElementSetMessagingTimeout,
+};
+use core_foundation::{
+    base::{CFRelease, CFTypeRef, TCFType},
+    runloop::*,
+    string::{CFString, CFStringRef},
+};
+use std::{
+    ffi::c_void,
+    sync::{
+        atomic::{AtomicBool, Ordering},
+        Arc, Mutex, OnceLock,
+    },
+    time::{Duration, Instant},
+};
+use tokio::sync::{oneshot, Notify, Semaphore};
+
+const QUIET: Duration = Duration::from_millis(75);
+const LIMIT: Duration = Duration::from_millis(1000);
+const NOTIFICATIONS: &[&str] = &[
+    "AXValueChanged",
+    "AXSelectedTextChanged",
+    "AXSelectedChildrenChanged",
+    "AXFocusedUIElementChanged",
+    "AXFocusedWindowChanged",
+    "AXWindowCreated",
+    "AXUIElementDestroyed",
+    "AXLayoutChanged",
+    "AXTitleChanged",
+    "AXMenuOpened",
+    "AXMenuClosed",
+];
+
+tokio::task_local! { pub(crate) static MONITORED_ACTION: bool; }
+
+#[repr(C)]
+struct Observer(c_void);
+type ObserverRef = *mut Observer;
+#[link(name = "ApplicationServices", kind = "framework")]
+extern "C" {
+    fn AXObserverCreate(
+        pid: i32,
+        callback: unsafe extern "C" fn(ObserverRef, AXUIElementRef, CFStringRef, *mut c_void),
+        observer: *mut ObserverRef,
+    ) -> i32;
+    fn AXObserverAddNotification(
+        observer: ObserverRef,
+        element: AXUIElementRef,
+        notification: CFStringRef,
+        context: *mut c_void,
+    ) -> i32;
+    fn AXObserverGetRunLoopSource(observer: ObserverRef) -> CFRunLoopSourceRef;
+}
+
+struct Activity {
+    last: Instant,
+    observed_through: Instant,
+    events: u64,
+}
+struct Shared {
+    activity: Mutex<Activity>,
+    changed: Notify,
+    stop: AtomicBool,
+    alive: AtomicBool,
+}
+
+pub use cua_driver_contract::ActionSettling as Settling;
+use cua_driver_contract::{SettlingScope, SettlingStatus};
+pub fn unavailable() -> Settling {
+    Settling {
+        status: SettlingStatus::Unavailable,
+        scope: SettlingScope::ProcessNotifications,
+        elapsed_ms: 0,
+        events: 0,
+        subscriptions: 0,
+    }
+}
+
+pub struct Monitor {
+    shared: Arc<Shared>,
+    subscriptions: usize,
+}
+impl Drop for Monitor {
+    fn drop(&mut self) {
+        self.shared.stop.store(true, Ordering::Release);
+    }
+}
+
+impl Monitor {
+    pub async fn start(pid: i32) -> Option<Self> {
+        static GATE: OnceLock<Arc<Semaphore>> = OnceLock::new();
+        let permit = GATE
+            .get_or_init(|| Arc::new(Semaphore::new(4)))
+            .clone()
+            .try_acquire_owned()
+            .ok()?;
+        let shared = Arc::new(Shared {
+            activity: Mutex::new(Activity {
+                last: Instant::now(),
+                observed_through: Instant::now(),
+                events: 0,
+            }),
+            changed: Notify::new(),
+            stop: AtomicBool::new(false),
+            alive: AtomicBool::new(false),
+        });
+        let mut monitor = Self {
+            shared: shared.clone(),
+            subscriptions: 0,
+        };
+        let (tx, rx) = oneshot::channel();
+        std::thread::Builder::new()
+            .name("mako-ax-activity".into())
+            .spawn(move || {
+                let _permit = permit;
+                unsafe { observe(pid, &shared, tx) };
+                shared.alive.store(false, Ordering::Release);
+                shared.changed.notify_one();
+            })
+            .ok()?;
+        monitor.subscriptions = tokio::time::timeout(Duration::from_millis(300), rx)
+            .await
+            .ok()?
+            .ok()?;
+        (monitor.subscriptions > 0).then_some(monitor)
+    }
+
+    pub async fn finish(&self) -> Settling {
+        let start = Instant::now();
+        loop {
+            let changed = self.shared.changed.notified();
+            let (last, observed_through, events) = {
+                let state = self.shared.activity.lock().unwrap();
+                (state.last.max(start), state.observed_through, state.events)
+            };
+            let now = Instant::now();
+            let status = decision(
+                self.shared.alive.load(Ordering::Acquire),
+                now.duration_since(start),
+                observed_through.saturating_duration_since(last),
+            );
+            if let Some(status) = status {
+                return Settling {
+                    status,
+                    scope: SettlingScope::ProcessNotifications,
+                    elapsed_ms: start.elapsed().as_millis() as u64,
+                    events,
+                    subscriptions: self.subscriptions as u32,
+                };
+            }
+            // A paused observer is not evidence of quiet. Avoid spinning when
+            // wall time passed the quiet boundary but the observer has not
+            // serviced its run loop through that boundary yet.
+            let wait = (last + QUIET)
+                .max(now + Duration::from_millis(5))
+                .min(start + LIMIT)
+                .saturating_duration_since(now);
+            tokio::select! { _ = changed => {}, _ = tokio::time::sleep(wait) => {} }
+        }
+    }
+}
+
+fn decision(alive: bool, elapsed: Duration, quiet: Duration) -> Option<SettlingStatus> {
+    if !alive {
+        Some(SettlingStatus::Unavailable)
+    } else if elapsed >= LIMIT {
+        Some(SettlingStatus::Deadline)
+    } else if quiet >= QUIET {
+        Some(SettlingStatus::EventsQuiet)
+    } else {
+        None
+    }
+}
+
+unsafe extern "C" fn notification(
+    _: ObserverRef,
+    _: AXUIElementRef,
+    _: CFStringRef,
+    context: *mut c_void,
+) {
+    // The run-loop thread owns a live Arc for longer than observer and source.
+    let shared = &*(context as *const Shared);
+    if let Ok(mut state) = shared.activity.lock() {
+        state.last = Instant::now();
+        state.events = state.events.saturating_add(1);
+    }
+    shared.changed.notify_one();
+}
+
+unsafe fn observe(pid: i32, shared: &Arc<Shared>, ready: oneshot::Sender<usize>) {
+    let app = AXUIElementCreateApplication(pid);
+    if app.is_null() {
+        return;
+    }
+    let mut observer = std::ptr::null_mut();
+    if AXObserverCreate(pid, notification, &mut observer) != 0 || observer.is_null() {
+        CFRelease(app as CFTypeRef);
+        return;
+    }
+    AXUIElementSetMessagingTimeout(app, 0.05);
+    let mut subscriptions = 0;
+    for name in NOTIFICATIONS {
+        if shared.stop.load(Ordering::Acquire) {
+            break;
+        }
+        let name = CFString::new(name);
+        if AXObserverAddNotification(
+            observer,
+            app,
+            name.as_concrete_TypeRef(),
+            Arc::as_ptr(shared) as *mut c_void,
+        ) == 0
+        {
+            subscriptions += 1;
+        }
+    }
+    let source = AXObserverGetRunLoopSource(observer);
+    let runloop = CFRunLoopGetCurrent();
+    if !source.is_null() && subscriptions > 0 {
+        CFRunLoopAddSource(runloop, source, kCFRunLoopDefaultMode);
+        shared.alive.store(true, Ordering::Release);
+    } else {
+        subscriptions = 0;
+    }
+    let admitted = ready.send(subscriptions).is_ok();
+    let deadline = Instant::now() + Duration::from_secs(120);
+    while admitted
+        && subscriptions > 0
+        && !shared.stop.load(Ordering::Acquire)
+        && Instant::now() < deadline
+    {
+        CFRunLoopRunInMode(kCFRunLoopDefaultMode, 0.02, 1);
+        if let Ok(mut state) = shared.activity.lock() {
+            state.observed_through = Instant::now();
+        }
+        shared.changed.notify_one();
+    }
+    if !source.is_null() {
+        CFRunLoopRemoveSource(runloop, source, kCFRunLoopDefaultMode);
+    }
+    CFRelease(observer as CFTypeRef);
+    CFRelease(app as CFTypeRef);
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn active_bursts_extend_wait_but_never_the_deadline() {
+        assert_eq!(
+            decision(true, Duration::from_millis(400), Duration::from_millis(20)),
+            None
+        );
+        assert_eq!(
+            decision(true, Duration::from_millis(500), QUIET),
+            Some(SettlingStatus::EventsQuiet)
+        );
+        assert_eq!(
+            decision(true, LIMIT, Duration::ZERO),
+            Some(SettlingStatus::Deadline)
+        );
+        assert_eq!(
+            decision(false, Duration::ZERO, QUIET),
+            Some(SettlingStatus::Unavailable)
+        );
+    }
+    #[tokio::test]
+    async fn observer_starvation_cannot_be_reported_as_quiet() {
+        let past = Instant::now() - Duration::from_secs(2);
+        let monitor = Monitor {
+            shared: Arc::new(Shared {
+                activity: Mutex::new(Activity {
+                    last: past,
+                    observed_through: past,
+                    events: 1,
+                }),
+                changed: Notify::new(),
+                stop: AtomicBool::new(false),
+                alive: AtomicBool::new(true),
+            }),
+            subscriptions: 1,
+        };
+        assert_eq!(monitor.finish().await.status, SettlingStatus::Deadline);
+    }
+    #[tokio::test]
+    async fn cancellation_closes_the_observer_owner() {
+        let shared = Arc::new(Shared {
+            activity: Mutex::new(Activity {
+                last: Instant::now(),
+                observed_through: Instant::now(),
+                events: 0,
+            }),
+            changed: Notify::new(),
+            stop: AtomicBool::new(false),
+            alive: AtomicBool::new(true),
+        });
+        drop(Monitor {
+            shared: shared.clone(),
+            subscriptions: 1,
+        });
+        assert!(shared.stop.load(Ordering::Acquire));
+    }
+}
