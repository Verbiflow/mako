+// Read geometry only when an owned recording actually requests this dispatch.
+fn record_window_pointer(xid: u64, x: i32, y: i32, pressed: bool) {
+    let Some(pid) = cua_driver_core::recording::recording_target_pid(xid) else {
+        return;
+    };
+    cua_driver_core::recording::record_pointer_dispatch(
+        xid,
+        pid,
+        || {
+            let window = crate::x11::list_windows(Some(u32::try_from(pid).ok()?))
+                .into_iter()
+                .find(|w| w.xid == xid)?;
+            if window.width == 0 || window.height == 0 {
+                return None;
+            }
+            Some((
+                f64::from(x) / f64::from(window.width),
+                f64::from(y) / f64::from(window.height),
+            ))
+        },
+        pressed,
+    );
+}
+
+// Screen events are recorded only when an exact-window recording owns this
+// dispatch. Ordinary desktop input does not manufacture a window target.
+fn record_screen_pointer(x: i32, y: i32, pressed: bool) {
+    let Some((xid, pid)) = cua_driver_core::recording::recording_dispatch_target() else {
+        return;
+    };
+    cua_driver_core::recording::record_pointer_dispatch(
+        xid,
+        pid,
+        || {
+            let window = crate::x11::list_windows(Some(u32::try_from(pid).ok()?))
+                .into_iter()
+                .find(|window| window.xid == xid)?;
+            if window.width == 0 || window.height == 0 {
+                return None;
+            }
+            Some((
+                (f64::from(x) - f64::from(window.x)) / f64::from(window.width),
+                (f64::from(y) - f64::from(window.y)) / f64::from(window.height),
+            ))
+        },
+        pressed,
+    );
+}
