diff --git a/libs/cua-driver/rust/crates/platform-linux/src/video_window.rs b/libs/cua-driver/rust/crates/platform-linux/src/video_window.rs
new file mode 100644
index 0000000..b48c9de
--- /dev/null
+++ b/libs/cua-driver/rust/crates/platform-linux/src/video_window.rs
@@ -0,0 +1,314 @@
+//! Exact-window pixel sources share one bounded, task-owned FFmpeg encoder.
+use crate::capture::CompositeCapture;
+use cua_driver_core::video::{VideoBackend, VideoBackendFactory, VideoMetadata, WindowVideoTarget};
+use std::{
+    io::{Read, Write},
+    path::{Path, PathBuf},
+    process::{Command, Stdio},
+    sync::{
+        atomic::{AtomicBool, Ordering},
+        mpsc, Arc,
+    },
+    time::{Duration, Instant},
+};
+static ACTIVE: AtomicBool = AtomicBool::new(false);
+struct Admission;
+impl Drop for Admission {
+    fn drop(&mut self) {
+        ACTIVE.store(false, Ordering::Release);
+    }
+}
+pub struct X11VideoBackendFactory;
+impl VideoBackendFactory for X11VideoBackendFactory {
+    fn start(&self, path: &Path) -> anyhow::Result<Box<dyn VideoBackend>> {
+        cua_driver_core::video_ffmpeg::FfmpegVideoBackendFactory.start(path)
+    }
+    fn max_window_fps(&self) -> u32 { 60 }
+    fn start_window(
+        &self,
+        path: &Path,
+        target: WindowVideoTarget,
+        fps: u32,
+    ) -> anyhow::Result<Box<dyn VideoBackend>> {
+        start_window_capture(path, fps, move || {
+            Ok(Box::new(CompositeCapture::new(
+                target.window_id,
+                u32::try_from(target.pid)?,
+            )?))
+        })
+    }
+}
+
+pub(super) trait WindowCapture {
+    fn dimensions(&self) -> (u32, u32);
+    fn frame(&self) -> anyhow::Result<Vec<u8>>;
+}
+impl WindowCapture for CompositeCapture {
+    fn dimensions(&self) -> (u32, u32) {
+        self.dimensions()
+    }
+    fn frame(&self) -> anyhow::Result<Vec<u8>> {
+        self.frame()
+    }
+}
+
+pub(super) fn start_window_capture(
+    path: &Path,
+    fps: u32,
+    capture: impl FnOnce() -> anyhow::Result<Box<dyn WindowCapture>> + Send + 'static,
+) -> anyhow::Result<Box<dyn VideoBackend>> {
+    if path.exists() {
+        anyhow::bail!("Recording output exists; choose a new directory");
+    }
+    if ACTIVE
+        .compare_exchange(false, true, Ordering::AcqRel, Ordering::Acquire)
+        .is_err()
+    {
+        anyhow::bail!("A previous window encoder still owns capture");
+    }
+    let admission = Admission;
+    let stop = Arc::new(AtomicBool::new(false));
+    let worker_stop = stop.clone();
+    let (ready_tx, ready) = mpsc::sync_channel(1);
+    let (done_tx, done) = mpsc::sync_channel(1);
+    let finished = Arc::new(AtomicBool::new(false));
+    let worker_finished = finished.clone();
+    let path = path.to_path_buf();
+    std::thread::spawn(move || {
+        let _admission = admission;
+        let result =
+            capture().and_then(|capture| record(path, capture, fps, worker_stop, ready_tx.clone()));
+        if let Err(error) = &result {
+            let _ = ready_tx.try_send(Err(error.to_string()));
+        }
+        let _ = done_tx.send(result);
+        worker_finished.store(true, Ordering::Release);
+    });
+    match ready.recv_timeout(Duration::from_secs(5)) {
+        Ok(Ok(())) => Ok(Box::new(Recording {
+            stop,
+            done,
+            finished,
+        })),
+        result => {
+            stop.store(true, Ordering::Release);
+            match result {
+                Ok(Err(error)) => anyhow::bail!(error),
+                _ => {
+                    anyhow::bail!("Window recording startup timed out; worker retains cleanup")
+                }
+            }
+        }
+    }
+}
+
+struct Recording {
+    stop: Arc<AtomicBool>,
+    done: mpsc::Receiver<anyhow::Result<VideoMetadata>>,
+    finished: Arc<AtomicBool>,
+}
+impl Drop for Recording {
+    fn drop(&mut self) {
+        self.stop.store(true, Ordering::Release);
+    }
+}
+impl VideoBackend for Recording {
+    fn is_recording(&self) -> bool {
+        !self.finished.load(Ordering::Acquire)
+    }
+    fn stop(self: Box<Self>) -> anyhow::Result<VideoMetadata> {
+        self.stop.store(true, Ordering::Release);
+        self.done
+            .recv_timeout(Duration::from_secs(10))
+            .map_err(|_| anyhow::anyhow!("Window encoder cleanup is still pending"))?
+    }
+}
+struct Encoder(std::process::Child);
+impl Drop for Encoder {
+    fn drop(&mut self) {
+        let _ = self.0.kill();
+        let _ = self.0.wait();
+    }
+}
+fn record(
+    path: PathBuf,
+    capture: Box<dyn WindowCapture>,
+    fps: u32,
+    stop: Arc<AtomicBool>,
+    ready: mpsc::SyncSender<Result<(), String>>,
+) -> anyhow::Result<VideoMetadata> {
+    use std::os::fd::AsRawFd;
+    let (width, height) = capture.dimensions();
+    let first = capture.frame()?;
+    if let Some(parent) = path.parent() {
+        std::fs::create_dir_all(parent)?;
+    }
+    let mut encoder = Encoder(
+        Command::new("ffmpeg")
+            .args([
+                "-n",
+                "-loglevel",
+                "error",
+                "-f",
+                "rawvideo",
+                "-pixel_format",
+                "rgba",
+                "-video_size",
+                &format!("{width}x{height}"),
+                "-framerate",
+                &fps.to_string(),
+                "-use_wallclock_as_timestamps",
+                "1",
+                "-i",
+                "pipe:0",
+                "-fps_mode",
+                "vfr",
+                "-an",
+                "-vf",
+                "pad=ceil(iw/2)*2:ceil(ih/2)*2",
+                "-c:v",
+                "libx264",
+                "-preset",
+                "ultrafast",
+                "-crf",
+                "18",
+                "-pix_fmt",
+                "yuv420p",
+                "-movflags",
+                "+faststart",
+            ])
+            .arg(&path)
+            .stdin(Stdio::piped())
+            .stdout(Stdio::null())
+            .stderr(Stdio::piped())
+            .spawn()?,
+    );
+    let mut input = encoder
+        .0
+        .stdin
+        .take()
+        .ok_or_else(|| anyhow::anyhow!("Missing encoder input"))?;
+    let mut stderr = encoder
+        .0
+        .stderr
+        .take()
+        .ok_or_else(|| anyhow::anyhow!("Missing encoder diagnostics"))?;
+    let diagnostics = std::thread::spawn(move || {
+        let mut tail = Vec::new();
+        let mut buf = [0u8; 4096];
+        while let Ok(n) = stderr.read(&mut buf) {
+            if n == 0 {
+                break;
+            }
+            tail.extend_from_slice(&buf[..n]);
+            if tail.len() > 4096 {
+                tail.drain(..tail.len() - 4096);
+            }
+        }
+        tail
+    });
+    let fd = input.as_raw_fd();
+    // Nonblocking pipe writes let cancellation break an encoder that stopped reading.
+    unsafe {
+        let flags = libc::fcntl(fd, libc::F_GETFL);
+        if flags < 0 || libc::fcntl(fd, libc::F_SETFL, flags | libc::O_NONBLOCK) < 0 {
+            anyhow::bail!("Cannot make encoder input cancellable");
+        }
+    }
+    let started = Instant::now();
+    let mut frame = first;
+    let mut failure = None;
+    let mut announced = false;
+    'capture: loop {
+        if stop.load(Ordering::Acquire) {
+            break;
+        }
+        let mut bytes = frame.as_slice();
+        let write_deadline = Instant::now() + Duration::from_secs(2);
+        while !bytes.is_empty() {
+            if Instant::now() >= write_deadline {
+                failure = Some("Encoder stopped consuming frames".into());
+                break 'capture;
+            }
+            match input.write(bytes) {
+                Ok(0) => {
+                    failure = Some("Encoder closed its input".to_string());
+                    break 'capture;
+                }
+                Ok(n) => bytes = &bytes[n..],
+                Err(e) if e.kind() == std::io::ErrorKind::WouldBlock => {
+                    // A fixed sleep here costs one delay for every pipe-sized
+                    // slice of a frame. Wait for writability instead; the
+                    // deadline still bounds an encoder that stops reading.
+                    let mut poll = libc::pollfd { fd, events: libc::POLLOUT, revents: 0 };
+                    let result = unsafe { libc::poll(&mut poll, 1, 20) };
+                    if result < 0 {
+                        let error = std::io::Error::last_os_error();
+                        if error.kind() != std::io::ErrorKind::Interrupted {
+                            failure = Some(error.to_string());
+                            break 'capture;
+                        }
+                    }
+                }
+                Err(e) => {
+                    failure = Some(e.to_string());
+                    break 'capture;
+                }
+            }
+        }
+        if !announced {
+            let _ = ready.send(Ok(()));
+            announced = true;
+        }
+        let elapsed = started.elapsed().as_nanos();
+        // Absolute rational cadence: 60 fps is 16.666... ms, not 16 or 17.
+        // Skip missed slots under backpressure; never queue catch-up frames.
+        let next_tick = elapsed * u128::from(fps) / 1_000_000_000 + 1;
+        let next = Duration::from_nanos((next_tick * 1_000_000_000 / u128::from(fps)) as u64);
+        std::thread::sleep(next.saturating_sub(started.elapsed()));
+        if stop.load(Ordering::Acquire) {
+            break;
+        }
+        frame = match capture.frame() {
+            Ok(frame) => frame,
+            Err(error) => {
+                failure = Some(error.to_string());
+                break;
+            }
+        };
+    }
+    drop(input);
+    let deadline = Instant::now() + Duration::from_secs(5);
+    let mut finalized = false;
+    loop {
+        if let Some(status) = encoder.0.try_wait()? {
+            finalized = status.success();
+            if !finalized {
+                failure = Some(format!("Encoder exited {status}"));
+            }
+            break;
+        }
+        if Instant::now() >= deadline {
+            encoder.0.kill()?;
+            let _ = encoder.0.wait();
+            failure = Some("Encoder finalization timed out".into());
+            break;
+        }
+        std::thread::sleep(Duration::from_millis(20));
+    }
+    let tail = diagnostics.join().unwrap_or_default();
+    if !finalized {
+        anyhow::bail!(
+            "{}; {}; partial video: {}",
+            failure.as_deref().unwrap_or("Encoder did not finalize"),
+            String::from_utf8_lossy(&tail),
+            path.display()
+        );
+    }
+    Ok(VideoMetadata {
+        path,
+        duration_ms: started.elapsed().as_millis() as u64,
+        finalized: true,
+        interruption: failure,
+    })
+}
