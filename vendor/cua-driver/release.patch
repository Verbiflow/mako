diff --git a/libs/cua-driver/rust/crates/platform-macos/src/ax/window_surfaces.rs b/libs/cua-driver/rust/crates/platform-macos/src/ax/window_surfaces.rs
new file mode 100644
index 0000000..5671fa2
--- /dev/null
+++ b/libs/cua-driver/rust/crates/platform-macos/src/ax/window_surfaces.rs
@@ -0,0 +1,84 @@
+//! Exact AX window and attached-sheet discovery shared by reads and input guards.
+//! Sheets are native windows too, but AppKit omits them from AXWindows.
+use super::bindings::{copy_ax_windows, copy_children, copy_string_attr, AXUIElementRef};
+use core_foundation::base::{CFEqual, CFRelease, CFTypeRef};
+use std::{
+    sync::{atomic::AtomicBool, Arc},
+    time::{Duration, Instant},
+};
+
+const MAX_SURFACES: usize = 64;
+const MAX_CHILDREN: usize = 256;
+
+/// Returns retained window/sheet elements. Never searches arbitrary content or
+/// matches titles/geometry. Incomplete discovery returns no input candidates.
+/// Caller must release every returned element. `app` must remain valid.
+pub unsafe fn copy_window_surfaces(app: AXUIElementRef) -> Vec<AXUIElementRef> {
+    let Some(left) = super::read_budget::remaining() else {
+        return Vec::new();
+    };
+    let (mut surfaces, complete) = super::read_budget::within(
+        Instant::now() + left.min(Duration::from_millis(500)),
+        Arc::new(AtomicBool::new(false)),
+        || {
+            let mut surfaces = Vec::new();
+            let roots = copy_ax_windows(app).into_iter().chain(copy_children(app));
+            for element in roots {
+                let role = copy_string_attr(element, "AXRole");
+                if role.is_none() {
+                    super::read_budget::failed();
+                }
+                if matches!(role.as_deref(), Some("AXWindow" | "AXSheet")) {
+                    retain_unique(&mut surfaces, element);
+                } else {
+                    CFRelease(element as CFTypeRef);
+                }
+            }
+            let mut index = 0;
+            while index < surfaces.len() && super::read_budget::remaining().is_some() {
+                let children = copy_children(surfaces[index]);
+                if children.len() > MAX_CHILDREN {
+                    super::read_budget::failed();
+                }
+                for (position, child) in children.into_iter().enumerate() {
+                    let role = if position < MAX_CHILDREN {
+                        copy_string_attr(child, "AXRole")
+                    } else {
+                        None
+                    };
+                    if role.is_none() {
+                        super::read_budget::failed();
+                    }
+                    if role.as_deref() == Some("AXSheet") {
+                        retain_unique(&mut surfaces, child);
+                    } else {
+                        CFRelease(child as CFTypeRef);
+                    }
+                }
+                index += 1;
+            }
+            surfaces
+        },
+    );
+    if !complete {
+        for element in surfaces.drain(..) {
+            CFRelease(element as CFTypeRef);
+        }
+        super::read_budget::failed();
+    }
+    surfaces
+}
+
+unsafe fn retain_unique(elements: &mut Vec<AXUIElementRef>, element: AXUIElementRef) {
+    if elements
+        .iter()
+        .any(|&known| CFEqual(known as CFTypeRef, element as CFTypeRef) != 0)
+    {
+        CFRelease(element as CFTypeRef);
+    } else if elements.len() >= MAX_SURFACES {
+        CFRelease(element as CFTypeRef);
+        super::read_budget::failed();
+    } else {
+        elements.push(element);
+    }
+}
