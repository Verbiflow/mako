+/// The embedding host can require an already-focused exact window. Check
+/// before AT-SPI, pixel focus, clipboard, or keyboard routes can mutate state.
+fn require_focused_delivery(state: &ToolState, args: &Value) -> Option<ToolResult> {
+    use cua_driver_core::tool_args::ArgsExt;
+    if std::env::var_os("CUA_DRIVER_REQUIRE_FOCUSED_TARGET").as_deref()
+        != Some(std::ffi::OsStr::new("1"))
+        || !crate::input::delivery::DeliveryMode::from_args(args).is_foreground()
+    {
+        return None;
+    }
+    let pid = match args.require_u32("pid") {
+        Ok(pid) => pid,
+        Err(error) => return Some(error),
+    };
+    let mut window = args.opt_u64("window_id");
+    if window.is_none() {
+        match state.element_cache.resolve_element_args(
+            pid as i32,
+            args.opt_u64("element_index").map(|v| v as usize),
+            args.opt_str("element_token").as_deref(),
+            args.opt_str("snapshot_id").as_deref(),
+            None,
+            "foreground input",
+        ) {
+            Ok(cua_driver_core::element_token::ResolvedElement::Element { window_id, .. }) => {
+                window = window_id
+            }
+            Err(error) => return Some(error),
+            _ => {}
+        }
+    }
+    let verified = window.is_some_and(|xid| {
+        if crate::wayland::is_wayland() {
+            return crate::wayland::focused_target(pid, xid) == Some(true);
+        }
+        crate::x11::list_windows(Some(pid))
+            .iter()
+            .any(|w| w.xid == xid && w.is_on_screen)
+            && crate::x11::focused_window(xid) == Some(true)
+    });
+    (!verified).then(|| {
+        ToolResult::error("foreground_unavailable: exact target is not focused; no input sent")
+    })
+}
