+/// Attest both WM activation and actual keyboard focus, including child widgets.
+/// None means the server could not establish identity; stacking order is not focus.
+pub fn focused_window(xid: u64) -> Option<bool> {
+    let xid = u32::try_from(xid).ok()?;
+    let (conn, screen) = RustConnection::connect(None).ok()?;
+    let root = conn.setup().roots[screen].root;
+    let atom = get_atom(&conn, "_NET_ACTIVE_WINDOW").ok()?;
+    let active = conn
+        .get_property(false, root, atom, AtomEnum::WINDOW, 0, 1)
+        .ok()?
+        .reply()
+        .ok()?
+        .value32()?
+        .next()?;
+    if active != xid {
+        return Some(false);
+    }
+    let mut focused = conn.get_input_focus().ok()?.reply().ok()?.focus;
+    for _ in 0..64 {
+        if focused == xid {
+            return Some(true);
+        }
+        if focused <= 1 || focused == root {
+            return Some(false);
+        }
+        let parent = conn.query_tree(focused).ok()?.reply().ok()?.parent;
+        if parent == focused {
+            return None;
+        }
+        focused = parent;
+    }
+    None
+}
