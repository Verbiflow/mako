+/// Screencopy buffers use the output's physical orientation. Convert them to
+/// the logical coordinate frame before any window crop. Rotation and mirroring
+/// are lossless pixel permutations; resizing is performed only by the cropper.
+fn orient_output_pixels(
+    pixels: image::RgbaImage,
+    transform: Option<wl_output::Transform>,
+) -> anyhow::Result<image::RgbaImage> {
+    use image::imageops::{flip_horizontal_in_place, rotate180, rotate270, rotate90};
+    use wl_output::Transform;
+    let transform =
+        transform.ok_or_else(|| anyhow::anyhow!("capture output transform is unknown"))?;
+    let mut pixels = match transform {
+        Transform::Normal | Transform::Flipped => pixels,
+        Transform::_90 | Transform::Flipped90 => rotate90(&pixels),
+        Transform::_180 | Transform::Flipped180 => rotate180(&pixels),
+        Transform::_270 | Transform::Flipped270 => rotate270(&pixels),
+        _ => anyhow::bail!("capture output transform is unsupported"),
+    };
+    if matches!(
+        transform,
+        Transform::Flipped | Transform::Flipped90 | Transform::Flipped180 | Transform::Flipped270
+    ) {
+        flip_horizontal_in_place(&mut pixels);
+    }
+    Ok(pixels)
+}
