+/// Owns one XComposite redirection. Reading its pixmap excludes occluding
+/// windows and the physical cursor; no root-window capture fallback is allowed.
+pub struct CompositeCapture {
+    conn: x11rb::rust_connection::RustConnection,
+    window: u32,
+    pid: u32,
+    pid_atom: u32,
+    pixels: PixelCatalog,
+    size: (u16, u16),
+}
+impl CompositeCapture {
+    pub fn new(window: u32, pid: u32) -> Result<Self> {
+        use x11rb::protocol::{
+            composite::{ConnectionExt as _, Redirect},
+            xproto::ConnectionExt as _,
+        };
+        let (conn, _) = x11rb::connect(None)?;
+        conn.composite_query_version(0, 4)?.reply()?;
+        let pid_atom = conn.intern_atom(false, b"_NET_WM_PID")?.reply()?.atom;
+        let actual = conn
+            .get_property(
+                false,
+                window,
+                pid_atom,
+                x11rb::protocol::xproto::AtomEnum::CARDINAL,
+                0,
+                1,
+            )?
+            .reply()?
+            .value32()
+            .and_then(|mut values| values.next());
+        if actual != Some(pid) {
+            bail!("Window does not belong to the requested process");
+        }
+        let geometry = conn.get_geometry(window)?.reply()?;
+        checked_capture_dimensions(u32::from(geometry.width), u32::from(geometry.height))?;
+        if u64::from(geometry.width) * u64::from(geometry.height) > 16_000_000 {
+            bail!("Window exceeds video pixel budget");
+        }
+        conn.composite_redirect_window(window, Redirect::AUTOMATIC)?
+            .check()?;
+        let pixels = PixelCatalog::from_setup(conn.setup());
+        Ok(Self {
+            conn,
+            window,
+            pid,
+            pid_atom,
+            pixels,
+            size: (geometry.width, geometry.height),
+        })
+    }
+    pub fn dimensions(&self) -> (u32, u32) {
+        (u32::from(self.size.0), u32::from(self.size.1))
+    }
+    pub fn frame(&self) -> Result<Vec<u8>> {
+        use x11rb::protocol::{
+            composite::ConnectionExt as _,
+            xproto::{AtomEnum, ConnectionExt as _, ImageFormat},
+        };
+        let actual = self
+            .conn
+            .get_property(false, self.window, self.pid_atom, AtomEnum::CARDINAL, 0, 1)?
+            .reply()?
+            .value32()
+            .and_then(|mut values| values.next());
+        if actual != Some(self.pid) {
+            bail!("Recording window owner changed");
+        }
+        let geometry = self.conn.get_geometry(self.window)?.reply()?;
+        if (geometry.width, geometry.height) != self.size {
+            bail!("Recording window resized; capture stopped without changing targets");
+        }
+        let attributes = self.conn.get_window_attributes(self.window)?.reply()?;
+        let pixmap = self.conn.generate_id()?;
+        self.conn
+            .composite_name_window_pixmap(self.window, pixmap)?
+            .check()?;
+        let image = self
+            .conn
+            .get_image(
+                ImageFormat::Z_PIXMAP,
+                pixmap,
+                0,
+                0,
+                self.size.0,
+                self.size.1,
+                !0u32,
+            )?
+            .reply();
+        let _ = self.conn.free_pixmap(pixmap);
+        let image = image?;
+        let (width, height) = self.dimensions();
+        let decoder = self
+            .pixels
+            .decoder(width, height, image.depth, attributes.visual)?;
+        packed_zpixmap_to_rgba(&image.data, width, height, decoder)
+    }
+}
+impl Drop for CompositeCapture {
+    fn drop(&mut self) {
+        use x11rb::protocol::composite::{ConnectionExt as _, Redirect};
+        let _ = self
+            .conn
+            .composite_unredirect_window(self.window, Redirect::AUTOMATIC);
+        let _ = self.conn.flush();
+    }
+}
