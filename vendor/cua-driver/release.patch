+
+fn crop_scaled_output(
+    bytes: &[u8],
+    output: (i32, i32, u32, u32),
+    window: (i32, i32, u32, u32),
+) -> anyhow::Result<Vec<u8>> {
+    use image::GenericImageView;
+    let image = image::load_from_memory(bytes)?;
+    if output.2 == 0 || output.3 == 0 || window.2 == 0 || window.3 == 0 {
+        anyhow::bail!("capture geometry is empty");
+    }
+    let sx = f64::from(image.width()) / f64::from(output.2);
+    let sy = f64::from(image.height()) / f64::from(output.3);
+    if (sx - sy).abs() > 0.01 {
+        anyhow::bail!("capture output scale is inconsistent");
+    }
+    let x = i64::from(window.0) - i64::from(output.0);
+    let y = i64::from(window.1) - i64::from(output.1);
+    if x < 0
+        || y < 0
+        || x + i64::from(window.2) > i64::from(output.2)
+        || y + i64::from(window.3) > i64::from(output.3)
+    {
+        anyhow::bail!("target extends beyond the identified capture output");
+    }
+    let left = (x as f64 * sx).round() as u32;
+    let top = (y as f64 * sy).round() as u32;
+    let right = ((x + i64::from(window.2)) as f64 * sx).round() as u32;
+    let bottom = ((y + i64::from(window.3)) as f64 * sy).round() as u32;
+    if right <= left || bottom <= top || right > image.width() || bottom > image.height() {
+        anyhow::bail!("scaled capture rectangle is outside the output");
+    }
+    let crop = image.view(left, top, right - left, bottom - top).to_image();
+    let crop = image::imageops::resize(
+        &crop,
+        window.2,
+        window.3,
+        image::imageops::FilterType::Lanczos3,
+    );
+    let mut encoded = std::io::Cursor::new(Vec::new());
+    crop.write_to(&mut encoded, image::ImageFormat::Png)?;
+    Ok(encoded.into_inner())
+}
