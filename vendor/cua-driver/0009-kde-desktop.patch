+fn capture(method: &'static str, uuid: Option<String>) -> Result<image::RgbaImage, CaptureError> {
+    // KWin learns of a desktop entry written a moment ago only when its service cache next rebuilds: the first
+    // refusals are retried for a bounded time, and a standing refusal is remembered for five seconds, so the capture
+    // works soon after the person allows it.
+    static REFUSED_AT: Mutex<Option<Instant>> = Mutex::new(None);
+    static AUTHORIZED: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+    if REFUSED_AT.lock().ok().and_then(|at| *at).is_some_and(|at| at.elapsed() < Duration::from_secs(5)) {
+        return Err(CaptureError::NotAuthorized);
+    }
+    let attempts = if AUTHORIZED.load(Ordering::Relaxed) { 1 } else { 5 };
+    for attempt in 0..attempts {
+        if attempt > 0 {
+            std::thread::sleep(Duration::from_millis(700));
+        }
+        match capture_once(method, uuid.clone()) {
+            Ok(picture) => {
+                AUTHORIZED.store(true, Ordering::Relaxed);
+                return Ok(picture);
+            }
+            Err(CaptureError::NotAuthorized) => {}
+            Err(error) => return Err(error),
+        }
+    }
+    if let Ok(mut at) = REFUSED_AT.lock() {
+        *at = Some(Instant::now());
+    }
+    Err(CaptureError::NotAuthorized)
+}
