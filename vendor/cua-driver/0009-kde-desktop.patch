+/// The window itself out of what KWin captured: the picture as it is when it is the window's size, and the window's
+/// place inside its buffer when the picture is the whole buffer (a client-drawn shadow around it).
+pub fn window_picture(picture: image::RgbaImage, window: &KwinWindow) -> Option<image::RgbaImage> {
+    if (picture.width(), picture.height()) == (window.width, window.height) {
+        return Some(picture);
+    }
+    let (buffer_x, buffer_y, buffer_width, buffer_height) = window.buffer;
+    if (picture.width(), picture.height()) != (buffer_width, buffer_height) {
+        // Plasma 5.27 does not say where an X11 client lies inside its frame: the picture is the client alone, smaller
+        // than the window reported. It is still this window's and nothing else's. A larger one is unexplained.
+        return (picture.width() <= window.width && picture.height() <= window.height).then_some(picture);
+    }
+    let left = u32::try_from(window.x - buffer_x).ok()?;
+    let top = u32::try_from(window.y - buffer_y).ok()?;
+    (left + window.width <= buffer_width && top + window.height <= buffer_height)
+        .then(|| image::imageops::crop_imm(&picture, left, top, window.width, window.height).to_image())
+}
