+/// Prepare the already-validated exact background window's responder chain.
+/// Posts only to the target process. In particular, never defocus the user's
+/// process and never call SetFrontProcess or raise a window.
+/// The caller must hold the background exact-window mutation lease.
+pub fn make_background_window_key(pid: libc::pid_t, wid: u32) -> anyhow::Result<()> {
+    let post = post_event_record_to_fn()
+        .ok_or_else(|| anyhow::anyhow!("Local key-window events unavailable"))?;
+    let front = get_front_process_fn()
+        .ok_or_else(|| anyhow::anyhow!("Cannot verify WindowServer front process"))?;
+    let mut before = [0u8; 8];
+    if unsafe { front(before.as_mut_ptr() as *mut c_void) } != 0 {
+        anyhow::bail!("Cannot read WindowServer front process");
+    }
+    let mut target = [0u8; 8];
+    if !get_process_psn_for_window(wid, pid, &mut target) {
+        anyhow::bail!("Exact target process unavailable");
+    }
+    // The local AppKit activation record establishes an active responder chain,
+    // without changing WindowServer's front process or the user's active app.
+    let mut activation = [0u8; 0xF8];
+    activation[0x04] = 0xF8;
+    activation[0x08] = 0x0D;
+    activation[0x8A] = 0x01;
+    activation[0x3C..0x40].copy_from_slice(&wid.to_le_bytes());
+    for record in [
+        activation,
+        make_key_window_record(wid, 0x01),
+        make_key_window_record(wid, 0x02),
+    ] {
+        if unsafe { post(target.as_ptr() as *const c_void, record.as_ptr()) } != 0 {
+            anyhow::bail!("Local key-window event was not accepted");
+        }
+    }
+    if !await_window_focused(pid, wid) {
+        anyhow::bail!("Exact background window did not acquire local focus; no key posted");
+    }
+    let mut after = [0u8; 8];
+    if unsafe { front(after.as_mut_ptr() as *mut c_void) } != 0 || after != before {
+        anyhow::bail!("Foreground changed during preparation; no key posted");
+    }
+    Ok(())
+}
