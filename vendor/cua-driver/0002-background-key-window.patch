+/// Exact-window background key delivery. The tool owns the target-validation
+/// lease; this function owns responder preparation and the shared event route.
+pub fn press_key_in_window(
+    pid: i32,
+    window_id: u32,
+    key: &str,
+    modifiers: &[&str],
+) -> anyhow::Result<()> {
+    super::skylight::make_background_window_key(pid, window_id)?;
+    if modifiers.iter().any(|modifier| {
+        ["cmd", "command", "meta", "super"]
+            .iter()
+            .any(|name| modifier.eq_ignore_ascii_case(name))
+    }) {
+        // NSMenu key equivalents use the regular AppKit event path.
+        press_key_no_auth(pid, key, modifiers)
+    } else {
+        press_key(pid, key, modifiers)
+    }
+}
