{
  "name": "@mako/host",
  "version": "0.1.0",
  "license": "Elastic-2.0",
  "description": "Mako's host: the plain Node program that runs the coding agents, their Threads and worktrees, and serves every client. It imports nothing from Electron.",
  "type": "module",
  "bin": {
    "mako-host": "./dist/mako-host.js"
  },
  "exports": {
    "./base/*": "./dist/base/*.js",
    "./attribution": "./dist/attribution/index.js",
    "./attribution/*": "./dist/attribution/*.js",
    "./contracts/*": "./dist/contracts/*.js",
    "./application": "./dist/application/index.js",
    "./application/*": "./dist/application/*.js",
    "./conversations": "./dist/conversations/index.js",
    "./conversations/*": "./dist/conversations/*.js",
    "./control": "./dist/control/index.js",
    "./control/*": "./dist/control/*.js",
    "./mako-host": "./dist/mako-host.js",
    "./git": "./dist/git/index.js",
    "./git/*": "./dist/git/*.js",
    "./harnesses": "./dist/harnesses/index.js",
    "./harnesses/*": "./dist/harnesses/*.js",
    "./terminals": "./dist/terminals/index.js",
    "./terminals/*": "./dist/terminals/*.js",
    "./threads": "./dist/threads/index.js",
    "./threads/*": "./dist/threads/*.js",
    "./tools": "./dist/tools/index.js",
    "./tools/*": "./dist/tools/*.js",
    "./transport": "./dist/transport/index.js",
    "./transport/*": "./dist/transport/*.js",
    "./usage": "./dist/usage/index.js",
    "./usage/*": "./dist/usage/*.js",
    "./workspaces": "./dist/workspaces/index.js",
    "./workspaces/*": "./dist/workspaces/*.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsgo -b"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.3.0",
    "@ai-sdk/anthropic": "4.0.47",
    "@ai-sdk/google": "4.0.61",
    "@ai-sdk/openai": "4.0.55",
    "@ai-sdk/openai-compatible": "3.0.42",
    "@anthropic-ai/claude-agent-sdk": "0.3.283",
    "@cursor/sdk": "1.0.40",
    "@lydell/node-pty": "1.2.0-beta.15",
    "@mako/control": "0.1.0",
    "@mako/control-runtime": "0.1.0",
    "@mako/git": "0.1.0",
    "@mako/lazy": "0.1.0",
    "@mako/protocol": "0.1.0",
    "@mako/sessions": "0.1.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@napi-rs/keyring": "2.1.0",
    "@opencode/client": "2.0.27",
    "@parcel/watcher": "2.6.0",
    "ai": "7.0.89",
    "esbuild": "^0.28.2",
    "file-type": "^22.1.1",
    "image-size": "2.0.2",
    "jsonc-parser": "^3.3.1",
    "mime": "^4.1.0",
    "proper-lockfile": "^4.1.2",
    "react": "^19.2.6",
    "smol-toml": "^1.9.0",
    "text-extensions": "^3.1.0",
    "undici": "7.29.0",
    "ws": "8.21.3",
    "yaml": "^2.9.0",
    "zod": "4.4.3"
  }
}
