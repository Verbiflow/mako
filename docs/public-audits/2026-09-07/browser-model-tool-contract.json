    {
      "name": "mako_browser_cdp",
      "description": "Send a Chrome DevTools Protocol command to this exact target. Supports DOM, Runtime, Input, Network, Emulation, Page dialogs, downloads and other protocol domains. Browser/SystemInfo commands act on the browser. Target lifecycle uses open/select/release/close so ownership remains explicit. Use concurrent:true to answer a paused Fetch request or JavaScript dialog while another command is waiting. No failed command is replayed.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "target": {
            "type": "object",
            "properties": {
              "browser": {
                "type": "string"
              },
              "tab": {
                "type": "string"
              },
              "generation": {
                "type": "string"
              },
              "lease": {
                "type": "string"
              }
            },
            "required": [
              "browser",
              "tab",
              "generation",
              "lease"
            ],
            "additionalProperties": false
          },
          "method": {
            "type": "string",
            "pattern": "^[A-Za-z]+\\.[A-Za-z]+$"
